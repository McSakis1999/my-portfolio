---
import { profile, socials } from '../data/portfolio';
import { asset, href, names, labels, type Lang, type Page } from '../data/i18n';
interface Props { lang: Lang; page: Page; }
const { lang, page } = Astro.props;
const t = (el: string, en: string) => lang === 'el' ? el : en;
const icons: Record<string, string> = {
  LinkedIn: 'M5.37 24H.4V7.98h4.97V24ZM2.88 5.8a2.9 2.9 0 1 1 0-5.8 2.9 2.9 0 0 1 0 5.8ZM24 24h-4.97v-7.8c0-1.86-.04-4.25-2.59-4.25-2.59 0-2.98 2.02-2.98 4.12V24H8.49V7.98h4.77v2.19h.07c.66-1.26 2.29-2.59 4.71-2.59C23.08 7.58 24 10.9 24 15.2V24Z',
  GitHub: 'M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.93.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3Z',
  Facebook: 'M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.09 4.39 23.08 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.03 1.79-4.7 4.53-4.7 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.08 24 18.09 24 12.07Z',
};
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-intro">
        <a class="footer-logo" href={href(lang, 'home')} aria-label={t('MitsikostasTech αρχική', 'MitsikostasTech home')}><img src={asset('brand/logo-full.png')} alt="MitsikostasTech" width="1004" height="243" loading="lazy" /><span class="light-wordmark" aria-hidden="true"><img src={asset("brand/logo.png")} alt="" width="275" height="275" /><span class="brand-name">Mitsikostas<span>Tech</span></span></span></a>
        <p class="footer-name">{names[lang]}</p>
        <p>{t('Μηχανικός λογισμικού. Σχεδιάζω ιστοσελίδες και εφαρμογές που βοηθούν την επιχείρησή σας να προβάλλεται και να λειτουργεί καλύτερα.', 'Software engineer. I build websites and applications that help businesses showcase their work and run more efficiently.')}</p>
      </div>
      <div class="footer-section">
        <h2>{t('Γνωρίστε με', 'Explore')}</h2>
        <ul>{(['home', 'projects', 'experience', 'skills', 'about'] as Page[]).map(key => <li><a href={href(lang, key)} aria-current={page === key ? 'page' : undefined}>{labels[lang][key]}</a></li>)}</ul>
      </div>
      <div class="footer-section footer-contact">
        <h2>{t('Επικοινωνία', 'Contact')}</h2>
        <p>{t('Θέλετε να υλοποιήσετε ένα έργο ή αναζητάτε συνεργάτη για την ομάδα σας; Ας μιλήσουμε.', 'Have a project in mind or a role on your team? Let’s talk.')}</p>
        <a class="footer-email" href={`mailto:${profile.email}`}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg><span>{profile.email}</span></a>
        <a class="footer-contact-link" href={href(lang, 'contact')}>{t('Στοιχεία επικοινωνίας', 'Contact details')}</a>
      </div>
      <div class="footer-section">
        <h2>{t('Βρείτε με online', 'Find me online')}</h2>
        <ul class="footer-socials">{socials.map(s => <li><a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} — ${t('ανοίγει σε νέα καρτέλα', 'opens in a new tab')}`}>
          <span class="social-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill={s.label === 'Instagram' ? 'none' : 'currentColor'}>
            {s.label === 'Instagram' ? <g stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="6" /><circle cx="12" cy="12" r="4.5" /><circle cx="18" cy="6" r="1" fill="currentColor" stroke="none" /></g> : <path d={icons[s.label]} />}
          </svg></span>{s.label}
        </a></li>)}</ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} {names[lang]}. {t('Με επιφύλαξη παντός δικαιώματος.', 'All rights reserved.')}</p>
      <div class="language-switch" role="group" aria-label={t('Γλώσσα ιστοσελίδας', 'Website language')}>
        <a href={href('el', page)} lang="el" hreflang="el" aria-current={lang === 'el' ? 'true' : undefined} aria-label="Ελληνικά">ΕΛ</a><a href={href('en', page)} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined} aria-label="English">EN</a>
      </div>
    </div>
  </div>
</footer>
<style>
  .site-footer { display: block; padding: 0; border-top: 1px solid var(--tone-29425f, #29425f); background: radial-gradient(ellipse at 0 0, var(--tone-15365435, #15365435), transparent 55%), var(--tone-080f1c, #080f1c); color: var(--muted); font-size: .875rem; line-height: 1.75; }
  .footer-grid { display: grid; grid-template-columns: 1.35fr .7fr 1.2fr .8fr; gap: 40px; padding-block: 56px 44px; }
  .footer-logo { display: inline-flex; margin-bottom: 22px; }
  .footer-logo img { display: block; width: 220px; max-width: 100%; height: auto; }
  .footer-intro p { max-width: 300px; margin-bottom: 12px; }
  .footer-intro .footer-name { font-size: 1rem; font-weight: 600; color: var(--tone-e8eef8, #e8eef8); }
  .footer-section h2 { font-size: 1rem; font-weight: 600; color: var(--tone-e8eef8, #e8eef8); letter-spacing: 0; margin: 0 0 20px; }
  .footer-section ul { list-style: none; padding: 0; margin: 0; }
  .footer-section li + li { margin-top: 5px; }
  .footer-section li a { display: inline-flex; align-items: center; min-height: 36px; padding-block: 4px; gap: 12px; }
  .site-footer a { transition: color 180ms; }
  .site-footer a:hover, .site-footer a[aria-current]:not([hreflang]) { color: var(--cyan); }
  .footer-contact p { margin-bottom: 18px; }
  .footer-email { display: flex; align-items: center; gap: 10px; padding-block: 8px; color: var(--tone-d3e6fa, #d3e6fa); }
  .footer-email svg { width: 20px; height: 20px; flex-shrink: 0; color: var(--accent); }
  .footer-email span { overflow-wrap: anywhere; min-width: 0; }
  .footer-contact-link { display: inline-block; margin-top: 10px; padding-block: 6px; color: var(--accent); text-decoration: underline; text-underline-offset: 5px; }
  .social-icon { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--tone-29425f, #29425f); border-radius: 9px; background: var(--tone-112037, #112037); color: var(--tone-b9d5ef, #b9d5ef); transition: border-color 180ms, background 180ms; }
  .social-icon svg { width: 16px; height: 16px; }
  .footer-socials a:hover .social-icon { border-color: var(--accent); background: var(--tone-19334c, #19334c); color: var(--cyan); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid var(--line); padding-block: 22px; font-size: .875rem; }
  .footer-bottom p { margin: 0; }
  @media (max-width: 1050px) { .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 48px; } }
  @media (max-width: 540px) { .footer-grid { grid-template-columns: 1fr; gap: 30px; padding-block: 36px; } .footer-intro p { max-width: none; } .footer-section h2 { margin-bottom: 12px; } .footer-bottom { align-items: flex-start; flex-direction: column; gap: 10px; } .footer-socials { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; } .footer-section .footer-socials li { margin: 0; } }
  @media (prefers-reduced-motion: reduce) { .site-footer a, .social-icon { transition: none; } }
</style>
