---
import Base from '../layouts/Base.astro';
import ExpertiseStrip from './ExpertiseStrip.astro';
import ContactBanner from './ContactBanner.astro';
import ContactPage from './ContactPage.astro';
import AboutPage from './AboutPage.astro';
import ExperiencePage from './ExperiencePage.astro';
import SkillsPage from './SkillsPage.astro';
import ProjectsPage from './ProjectsPage.astro';
import FeaturedProjects from './FeaturedProjects.astro';
import { asset, career, href, labels, names, type Lang, type Page } from '../data/i18n';
interface Props { lang: Lang; page: Page; }
const { lang, page } = Astro.props;
const t = (el: string, en: string) => lang === 'el' ? el : en;
const data = career(lang);
const descriptions = {
 projects: t('Λογισμικό και ιστοσελίδες, τα προβλήματα που λύνουν και η συνεισφορά μου σε κάθε έργο.', 'Software and websites, the problems they solve, and my contribution to each project.'),
 experience: t('Η πορεία μου σε εταιρείες τεχνολογίας και έργα πελατών, με τις ευθύνες και τις εμπειρίες κάθε ρόλου.', 'My experience at technology companies and on client projects, including my responsibilities and what I learned in each role.'),
 skills: t('Οι γνώσεις, τα εργαλεία και ο τρόπος που δουλεύω για να δημιουργώ χρήσιμες εφαρμογές.', 'The technical tools, problem-solving skills, and ways of working I use to build useful software.'),
};
---
<Base lang={lang} page={page}>
{page === 'home' && <>
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{names[lang]} · {t('Μηχανικός λογισμικού','Software engineer')}</p><h1>{t('Δημιουργώ λογισμικό.', 'Building software.')}<br /><em>{t('Δίνω ζωή σε ιδέες.', 'Making ideas work.')}</em></h1><p class="lead">{t('Είμαι ο Θανάσης, μηχανικός λογισμικού. Αναπτύσσω εφαρμογές και ιστοσελίδες για εταιρείες και πελάτες, μετατρέποντας ιδέες και καθημερινές ανάγκες σε πρακτικές ψηφιακές λύσεις.', 'I’m Thanasis, a software engineer. I build software and websites for companies and clients, turning ideas and everyday challenges into practical digital solutions.')}</p><div class="actions"><a class="button" href={href(lang,'projects')}>{t('Δείτε τα έργα μου','Explore my work')}<span class="arrow" aria-hidden="true">↗</span></a><a class="secondary-link" href={href(lang,'about')}>{t('Γνωρίστε με','Get to know me')}<span class="arrow" aria-hidden="true">→</span></a></div><div class="note"><span class="note-icon" aria-hidden="true">&lt;/&gt;</span><p>{t('Τεχνική σκέψη.', 'Technical thinking.')}<br /><strong>{t('Σαφής επικοινωνία. Ουσιαστικά αποτελέσματα.', 'Clear communication. Useful results.')}</strong></p></div></div><div class="visual" aria-hidden="true"><div class="visual-bar"><div class="window-dots"><i></i><i></i><i></i></div><small>{t('ΑΠΟ ΤΗΝ ΙΔΕΑ ΣΤΗΝ ΠΡΑΞΗ','FROM IDEA TO REALITY')}</small><span>↗</span></div><div class="visual-canvas"><div class="orbit"></div><div class="logo-core"><img src={asset("brand/logo.png")} alt="" width="275" height="275" /></div><span class="node node-idea">01 <b>{t('Κατανόηση','Understand')}</b></span><span class="node node-build">02 <b>{t('Υλοποίηση','Build')}</b></span><span class="node node-deliver">03 <b>{t('Βελτίωση','Improve')}</b></span></div><div class="visual-caption"><span class="status-dot"></span><small>{t('ΣΥΝΘΕΤΑ ΠΡΟΒΛΗΜΑΤΑ. ΠΡΑΚΤΙΚΕΣ ΛΥΣΕΙΣ.','COMPLEX PROBLEMS. PRACTICAL SOLUTIONS.')}</small></div></div></section>
<ExpertiseStrip lang={lang} />
<section class="wrap local-intro" aria-labelledby="local-title"><h2 id="local-title">{t('Ιστοσελίδες και εφαρμογές στον Βόλο — και πέρα από αυτόν.', 'Websites and applications in Volos — and beyond.')}</h2><p>{t('Με βάση τον Βόλο, συνεργάζομαι με επαγγελματίες και επιχειρήσεις που χρειάζονται μια σύγχρονη ιστοσελίδα, καλύτερη προβολή στις μηχανές αναζήτησης ή μια εφαρμογή για την καθημερινή τους λειτουργία. Αναλαμβάνω συνεργασίες τοπικά και εξ αποστάσεως, με επικοινωνία στα ελληνικά και στα αγγλικά.', 'Based in Volos, Greece, I work with professionals and businesses that need a modern website, better visibility in search results, or an application for their everyday operations. I collaborate locally and remotely, in Greek and English.')}</p><a href={href(lang,'contact')}>{t('Ας συζητήσουμε το έργο σας', 'Discuss your project')}</a></section>
<FeaturedProjects lang={lang} />
<section class="wrap section"><div class="heading" data-reveal><div><p class="eyebrow">{t('ΤΟ PORTFOLIO ΜΟΥ','EXPLORE MY PORTFOLIO')}</p><h2>{t('Γνωρίστε τη δουλειά μου.','Explore my work.')}</h2></div><p>{t('Τα έργα μου, η επαγγελματική μου πορεία και όσα μπορώ να προσφέρω στην ομάδα σας.', 'My projects, professional experience, and what I can contribute to your team.')}</p></div><div class="cards">{(['projects','experience','skills'] as const).map((key,i) => <a class="card" data-reveal style={`--i:${i}`} href={href(lang,key)}><small>0{i+1}<span>↗</span></small><div class={`art art-${i}`} aria-hidden="true"><svg viewBox="0 0 160 100">{i === 0 ? <><rect x="15" y="15" width="130" height="76" rx="7" /><path d="M15 34h130M30 25h2m8 0h2m8 0h2M30 48h42v29H30zM85 50h43m-43 12h32m-32 12h38" /></> : i === 1 ? <path d="M25 80h110M42 80V55h20v25m12 0V37h20v43m12 0V19h20v61" /> : <path d="m54 27-26 23 26 23m52-46 26 23-26 23M91 16 69 84" />}</svg></div><h3>{labels[lang][key]}</h3><p>{descriptions[key]}</p><small class="card-link">{t('ΔΕΙΤΕ ΠΕΡΙΣΣΟΤΕΡΑ','EXPLORE MORE')} <span class="arrow" aria-hidden="true">→</span></small></a>)}</div></section>
<ContactBanner lang={lang} />
</>}

{/* Scroll reveal: put this once, right after the home block (or anywhere inside <Base>) */}
<script>
  const items = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('is-visible'));
  }
</script>
{page === 'experience' && <ExperiencePage lang={lang} />}
{page === 'skills' && <SkillsPage lang={lang} />}
{page === 'projects' && <ProjectsPage lang={lang} />}
{page === 'about' && <AboutPage lang={lang} />}
<!-- Contact content -->
{page === 'contact' && <ContactPage lang={lang} />}
</Base>







