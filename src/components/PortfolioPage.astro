---
import Base from '../layouts/Base.astro';
import { profile, socials } from '../data/portfolio';
import { career, href, labels, names, type Lang, type Page } from '../data/i18n';
interface Props { lang: Lang; page: Page; }
const { lang, page } = Astro.props;
const t = (el: string, en: string) => lang === 'el' ? el : en;
const data = career(lang);
const descriptions = {
 projects: t('Λογισμικό και ιστοσελίδες, τα προβλήματα που λύνουν και η συνεισφορά μου σε κάθε έργο.', 'Software and websites, the problems they solve, and my contribution to each project.'),
 experience: t('Η πορεία μου σε εταιρείες τεχνολογίας και έργα πελατών, με τις ευθύνες και τις εμπειρίες κάθε ρόλου.', 'My journey in technology companies and client projects, with the responsibilities and lessons from each role.'),
 skills: t('Οι τεχνολογίες, η επίλυση προβλημάτων και η συνεργασία που αξιοποιώ για να δημιουργώ χρήσιμο λογισμικό.', 'The technical tools, problem-solving skills, and ways of working I use to build useful software.'),
};
---
<Base lang={lang} page={page}>
{page === 'home' && <>
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{names[lang]} · {t('Μηχανικός λογισμικού','Software engineer')}</p><h1>{t('Δημιουργώ λογισμικό.', 'Building software.')}<br /><em>{t('Δίνω ζωή σε ιδέες.', 'Making ideas work.')}</em></h1><p class="lead">{t('Είμαι ο Θανάσης, μηχανικός λογισμικού. Αναπτύσσω εφαρμογές και ιστοσελίδες για εταιρείες και πελάτες, μετατρέποντας ιδέες και καθημερινές ανάγκες σε πρακτικές ψηφιακές λύσεις.', 'I’m Thanasis, a software engineer. I build software and websites for companies and clients, turning ideas and everyday challenges into practical digital solutions.')}</p><div class="actions"><a class="button" href={href(lang,'projects')}>{t('Δείτε τα έργα μου','Explore my work')} ↗</a><a class="secondary-link" href={href(lang,'about')}>{t('Γνωρίστε με','Get to know me')} →</a></div><div class="note"><span class="note-icon" aria-hidden="true">&lt;/&gt;</span><p>{t('Τεχνική σκέψη.', 'Technical thinking.')}<br /><strong>{t('Σαφής επικοινωνία. Ουσιαστικά αποτελέσματα.', 'Clear communication. Useful results.')}</strong></p></div></div><div class="visual" aria-hidden="true"><div class="visual-bar"><div class="window-dots"><i></i><i></i><i></i></div><small>{t('ΑΠΟ ΤΗΝ ΙΔΕΑ ΣΤΗΝ ΠΡΑΞΗ','FROM IDEA TO REALITY')}</small><span>↗</span></div><div class="visual-canvas"><div class="orbit"></div><div class="logo-core"><img src="/brand/logo.png" alt="" width="275" height="275" /></div><span class="node node-idea">01 <b>{t('Κατανόηση','Understand')}</b></span><span class="node node-build">02 <b>{t('Υλοποίηση','Build')}</b></span><span class="node node-deliver">03 <b>{t('Βελτίωση','Improve')}</b></span></div><div class="visual-caption"><span class="status-dot"></span><small>{t('ΣΥΝΘΕΤΑ ΠΡΟΒΛΗΜΑΤΑ. ΚΑΘΑΡΕΣ ΛΥΣΕΙΣ.','COMPLEX PROBLEMS. CLEAR SOLUTIONS.')}</small></div></div></section>
<div class="strip"><div class="wrap"><span>{t('Ανάπτυξη λογισμικού','Software engineering')}</span><span>/</span><span>{t('Web εφαρμογές','Web development')}</span><span>/</span><span>{t('Έργα εταιρειών και πελατών','Company & client work')}</span></div></div>
<section class="wrap section"><div class="heading"><div><p class="eyebrow">{t('ΤΟ PORTFOLIO ΜΟΥ','EXPLORE MY PORTFOLIO')}</p><h2>{t('Γνωρίστε τη δουλειά μου.','Get to know the work.')}</h2></div><p>{t('Τι έχω δημιουργήσει, πού έχω εργαστεί και τι φέρνω σε μια ομάδα.', 'What I’ve built, where I’ve worked, and the skills I bring to a team.')}</p></div><div class="cards">{(['projects','experience','skills'] as const).map((key,i) => <a class="card" href={href(lang,key)}><small>0{i+1}<span>↗</span></small><div class={`art art-${i}`} aria-hidden="true"><svg viewBox="0 0 160 100">{i === 0 ? <><rect x="15" y="15" width="130" height="76" rx="7" /><path d="M15 34h130M30 25h2m8 0h2m8 0h2M30 48h42v29H30zM85 50h43m-43 12h32m-32 12h38" /></> : i === 1 ? <path d="M25 80h110M42 80V55h20v25m12 0V37h20v43m12 0V19h20v61" /> : <path d="m54 27-26 23 26 23m52-46 26 23-26 23M91 16 69 84" />}</svg></div><h3>{labels[lang][key]}</h3><p>{descriptions[key]}</p><small class="card-link">{t('ΔΕΙΤΕ ΠΕΡΙΣΣΟΤΕΡΑ','EXPLORE MORE')} →</small></a>)}</div></section>
<section class="wrap closing"><div><p class="eyebrow">{t('ΑΣ ΣΥΝΕΡΓΑΣΤΟΥΜΕ','LET’S WORK TOGETHER')}</p><h2>{t('Έχετε μια θέση ή ένα έργο στο μυαλό σας;', 'Have a role or a project in mind?')}</h2><p class="lead">{t('Ας μιλήσουμε για τις ανάγκες σας και πώς μπορώ να βοηθήσω.', 'Let’s talk about what you’re looking for and how I can help.')}</p></div><a class="button" href={href(lang,'contact')}>{t('Ας μιλήσουμε','Start a conversation')} ↗</a></section>
</>}
{page === 'experience' && <>
<section class="page wrap"><p class="eyebrow">{t('ΕΠΑΓΓΕΛΜΑΤΙΚΗ ΕΜΠΕΙΡΙΑ','PROFESSIONAL EXPERIENCE')}</p><h1>{t('Δημιουργώ λογισμικό.','Building software.')}<br /><em>{t('Εξελίσσομαι με την ομάδα.','Growing with the team.')}</em></h1><p class="lead">{t('Από ιστοσελίδες και εργαλεία μάθησης μέχρι την ηγεσία στην ανάπτυξη frontend για επιχειρησιακές εφαρμογές web και mobile.', 'From websites and learning tools to leading frontend development for enterprise web and mobile applications.')}</p></section>
<section class="wrap career-section" aria-label={labels[lang].experience}>{data.experience.map(job => <article class:list={['career-entry',{'current-role':job.current}]}><div class="career-meta"><p class="eyebrow">{job.current ? t('ΤΡΕΧΩΝ ΡΟΛΟΣ','CURRENT ROLE') : t('ΠΡΟΗΓΟΥΜΕΝΟΣ ΡΟΛΟΣ','PREVIOUS ROLE')}</p><p>{job.period}</p></div><div><h2>{job.role}</h2><h3>{job.company}</h3><p>{job.summary}</p>{job.bullets.length > 0 && <ul>{job.bullets.map(b => <li>{b}</li>)}</ul>}</div></article>)}</section>
<section class="wrap section"><div class="heading"><div><p class="eyebrow">{t('ΕΚΠΑΙΔΕΥΣΗ','EDUCATION')}</p><h2>{t('Βάσεις στη μηχανική λογισμικού.','A foundation in software.')}</h2></div></div><article class="card education"><small>{t('ΣΕΠΤΕΜΒΡΙΟΣ 2017 – ΙΟΥΝΙΟΣ 2023','SEPTEMBER 2017 – JUNE 2023')}</small><h3>{t('Μηχανικών Πληροφορικής · Πανεπιστήμιο Θεσσαλίας','Informatics Engineering · University of Thessaly')}</h3><p>{t('Κατεύθυνση λογισμικού · Βαθμός: 7,4/10 · 240 ECTS','Software specialisation · Final grade: 7.4/10 · 240 ECTS')}</p><p>{t('Πτυχιακή: ανάπτυξη εφαρμογής Flutter και μαθημάτων με την εφαρμογή ως εξελισσόμενο παράδειγμα.', 'Thesis: developing a Flutter application and lessons using it as an evolving example.')}</p><div class="tags"><span>Google · How to Design & Build a Website</span><span>{t('Michigan · ECPE, πιστοποίηση αγγλικών','Michigan · ECPE English proficiency')}</span></div></article></section>
</>}
{page === 'skills' && <><section class="page wrap"><p class="eyebrow">{t('ΔΕΞΙΟΤΗΤΕΣ ΚΑΙ ΓΝΩΣΕΙΣ','SKILLS & KNOWLEDGE')}</p><h1>{t('Τεχνική γνώση.','Technical depth.')}<br /><em>{t('Πρακτική σκέψη.','Practical thinking.')}</em></h1><p class="lead">{t('Αρχιτεκτονική, ανάπτυξη και συνεργασία σε εφαρμογές web και mobile, με εμπειρία σε τεχνολογίες frontend και backend.', 'Architecture, development, and collaboration across web and mobile software, built on a background in frontend and backend technologies.')}</p></section><section class="wrap career-section"><div class="skill-grid">{data.skills.map(g => <article class="card"><small>{g.context}</small><h2>{g.title}</h2><div class="tags">{g.skills.map(s => <span>{s}</span>)}</div></article>)}</div><div class="language-note"><h2>{t('Επικοινωνία','Communication')}</h2><p>{t('Ελληνικά: μητρική γλώσσα. Αγγλικά: πιστοποίηση ECPE, με δεξιότητες C1–C2 στο παλαιότερο βιογραφικό.', 'Greek: native language. English: ECPE proficiency, with C1–C2 skills recorded in my earlier CV.')}</p><p>{t('Εμπειρία στην παρουσίαση έρευνας σε Ευρωπαίους εταίρους έργων και στην καθοδήγηση εκπαιδευόμενων frontend developers.', 'Experience presenting research to European project partners and mentoring frontend trainees.')}</p></div></section></>}
{page === 'projects' && <><section class="page wrap"><p class="eyebrow">{t('ΕΡΓΑ ΚΑΙ ΣΥΝΕΙΣΦΟΡΕΣ','PROJECTS & CONTRIBUTIONS')}</p><h1>{t('Λογισμικό με','Software with')}<br /><em>{t('ουσιαστικό σκοπό.','a purpose.')}</em></h1><p class="lead">{t('Μια πρώτη εικόνα έργων από την προηγούμενη εργασία και τις σπουδές μου. Νεότερα έργα web, mobile και πελατών θα προστεθούν καθώς τεκμηριώνονται.', 'A first look at documented projects from my earlier work and studies. More recent web, mobile, and client case studies will be added as they’re documented.')}</p></section><section class="wrap career-section"><div class="cards">{data.projects.map(p => <article class="card"><small>{p.period}</small><h2>{p.title}</h2><p>{p.text}</p></article>)}</div></section></>}
{page === 'about' && <><section class="page wrap"><p class="eyebrow">{t('ΛΙΓΑ ΛΟΓΙΑ ΓΙΑ ΕΜΕΝΑ','BEHIND THE WORK')}</p><h1>{t('Γεια σας, είμαι ο Θανάσης.','Hi, I’m Thanasis.')}<br /><em>{t('Μηχανικός λογισμικού.','Software engineer.')}</em></h1><p class="lead">{t('Το πλήρες όνομά μου είναι Αθανάσιος Μητσικώστας. Δημιουργώ λογισμικό και ιστοσελίδες, με εμπειρία σε εταιρικά έργα, πλατφόρμες web, εφαρμογές mobile και εκπαιδευτικά εργαλεία.', 'My full name is Athanasios Mitsikostas. I build software and websites, with experience spanning company projects, web platforms, mobile development, and educational tools.')}</p></section><section class="wrap career-section about-copy"><h2>{t('Ηγεσία στην ανάπτυξη frontend στην AIPath.','Leading frontend development at AIPath.')}</h2><p>{t('Από τον Σεπτέμβριο του 2023 έχω την ευθύνη του frontend στην AIPath. Η δουλειά μου περιλαμβάνει την αρχιτεκτονική και την υλοποίηση εφαρμογών web και mobile, καθώς και την καθοδήγηση δύο εκπαιδευόμενων κατά τη διάρκεια της πορείας μου στην εταιρεία.', 'Since September 2023, I’ve been responsible for frontend development at AIPath. My work covers project architecture and implementation for web and mobile applications, alongside mentoring two trainees during my time with the company.')}</p><p>{t('Η AIPath αναπτύσσει επιχειρησιακό λογισμικό που συνδέει ανθρώπους, ρόλους, δεδομένα και αποφάσεις. Εστιάζει σε business operating systems, εφαρμογές web και mobile, αυτοματισμούς και AI με πρακτική χρήση.', 'AIPath builds enterprise software that connects people, roles, data, and decisions. Its work spans business operating systems, web and mobile applications, automation, and AI with practical applications.')}</p><h2>{t('Δημιουργία και συνεχής μάθηση.','A background in building and learning.')}</h2><p>{t('Σπούδασα Μηχανικών Πληροφορικής στο Πανεπιστήμιο Θεσσαλίας, με κατεύθυνση λογισμικού. Η προηγούμενη εμπειρία μου περιλαμβάνει ιστοσελίδες και backend συστήματα στην BEE GROUP, frontend στο ΚΑΣΜΝ του Πολεμικού Ναυτικού και συμμετοχή σε ευρωπαϊκά έργα ψηφιακής μάθησης.', 'I studied Informatics Engineering at the University of Thessaly, specialising in software. Earlier work includes website and backend development at BEE GROUP, frontend development at the Hellenic Navy’s Systems Automation Centre, and contributions to EU-funded digital learning projects.')}</p><div class="actions"><a class="button" href={href(lang,'experience')}>{t('Δείτε την εμπειρία μου','Explore my experience')} ↗</a><a class="secondary-link" href={href(lang,'contact')}>{labels[lang].contact} ↗</a></div></section></>}
{page === 'contact' && <><section class="page wrap"><p class="eyebrow">{t('ΑΣ ΓΝΩΡΙΣΤΟΥΜΕ','LET’S CONNECT')}</p><h1>{t('Ας ξεκινήσουμε','Let’s start a')}<br /><em>{t('μια συζήτηση.','conversation.')}</em></h1><p class="lead">{t('Για επαγγελματικές ευκαιρίες, συζήτηση ενός έργου ή ερωτήσεις για τη δουλειά μου, επικοινωνήστε μαζί μου μέσω email.', 'For job opportunities, project discussions, or questions about my work, reach out by email.')}</p><a class="button" href={`mailto:${profile.email}`}>{profile.email} ↗</a></section><section class="wrap career-section"><h2>{t('Βρείτε με και εδώ.','Find me here, too.')}</h2><div class="contact-socials">{socials.map(s => <a class="contact" href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div></section></>}
</Base>
