---
import { href, type Lang } from '../data/i18n';
import '../styles/skills.css';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (el: string, en: string) => lang === 'el' ? el : en;
const services = [
  { icon: 'M3 8h18M7 12h10M7 16h6M3 3h18v18H3z', title: t('Σχεδιασμός & κατασκευή ιστοσελίδων', 'Website design & development'), text: t('Σύγχρονες ιστοσελίδες που παρουσιάζουν την επιχείρησή σας, εξηγούν τις υπηρεσίες σας και κάνουν την επικοινωνία εύκολη.', 'Modern websites that introduce your business, explain your services, and make getting in touch easy.'), points: [t('Responsive σχεδιασμός για κινητά, tablet και υπολογιστές', 'Responsive layouts for phones, tablets, and desktops'), t('Οργάνωση περιεχομένου, σελίδες υπηρεσιών και εύκολοι τρόποι επικοινωνίας', 'Clear content structure, service pages, and easy ways to get in touch'), t('Ταχύτητα φόρτωσης, βελτιστοποίηση εικόνων και δημοσίευση', 'Loading performance, image optimisation, and deployment')] },
  { icon: 'M16 16l5 5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z', title: t('SEO & τοπική αναζήτηση', 'SEO & local search'), text: t('Βελτιώνω τη δομή, το περιεχόμενο και τα τεχνικά στοιχεία της ιστοσελίδας σας, ώστε οι μηχανές αναζήτησης να καταλαβαίνουν τι προσφέρετε.', 'I improve your website’s structure, content, and technical setup to help search engines understand what your business offers.'), points: [t('Τίτλοι, περιγραφές, δομημένα δεδομένα και sitemap', 'Page titles, descriptions, structured data, and sitemaps'), t('Περιεχόμενο υπηρεσιών, τοπικές σελίδες και χρήσιμες ερωταπαντήσεις', 'Service content, local pages, and useful FAQs'), t('Συνεπή στοιχεία επιχείρησης και σύνδεση με χάρτες', 'Consistent business details and map integration')] },
  { icon: 'M3 10v4h4l10 6V4L7 10H3Zm4 4 2 7h4l-3-6m10-6 2-2m-2 8 2 2', title: t('Ψηφιακή παρουσία & marketing', 'Digital presence & marketing'), text: t('Συνδέω τον σχεδιασμό και το περιεχόμενο με έναν πρακτικό στόχο: να καταλαβαίνει ο επισκέπτης τι προσφέρετε και να κάνει το επόμενο βήμα.', 'I connect design and content with a practical goal: helping visitors understand your offer and take the next step.'), points: [t('Οργάνωση του επαγγελματικού σας προφίλ στο Google Business Profile', 'Help setting up and organising your Google Business Profile'), t('Landing pages, περιεχόμενο υπηρεσιών και προεπισκοπήσεις για social media', 'Landing pages, service messaging, and social-sharing previews'), t('Google Analytics 4 και επιλογές συγκατάθεσης για analytics', 'Google Analytics 4 and analytics consent controls')] },
  { icon: 'M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm3 3h4m-3 14h2', title: t('Ανάπτυξη εφαρμογών για κινητά', 'Mobile app development'), text: t('Εφαρμογές για καθημερινές εργασίες και επιχειρησιακές ανάγκες, με εύκολο χειρισμό και πρόσβαση στα δεδομένα που χρειάζεστε.', 'Applications for everyday tasks and business needs, with straightforward controls and access to the data you need.'), points: ['React Native & Expo', t('Σύνδεση με backend, είσοδος χρηστών και διαχείριση κατάστασης', 'Backend integration, sign-in flows, and state management'), t('Δοκιμές σε πραγματικές συσκευές και προετοιμασία Android builds', 'Testing on real devices and preparing Android builds')] },
  { icon: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z', title: t('Web εφαρμογές & επιχειρησιακά εργαλεία', 'Web apps & business tools'), text: t('Εύχρηστες διεπαφές για σύνθετες εργασίες: διαχείριση παραγγελιών, προγράμματα εργασίας, πίνακες δεδομένων και καθημερινές λειτουργίες.', 'Usable interfaces for complex work: order management, schedules, data tables, and day-to-day operations.'), points: ['Vue.js, PrimeVue & Pinia', t('Διασύνδεση API, φόρμες, φίλτρα και διαχείριση δεδομένων', 'API integration, forms, filters, and data handling'), t('Αναφορές PDF, εξαγωγές Excel και διαδραστικοί χάρτες', 'PDF reports, Excel exports, and interactive maps')] },
  { icon: 'M8 8a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8 1a3 3 0 1 0 0-6m-15 18v-4a7 7 0 0 1 14 0v4m3-9a5 5 0 0 1 5 5v4', title: t('Αρχιτεκτονική & τεχνική συνεργασία', 'Architecture & technical collaboration'), text: t('Αναλαμβάνω την οργάνωση και υλοποίηση του frontend, με έμφαση στη συντήρηση, την επαναχρησιμοποίηση και τη συνεργασία με την ομάδα.', 'I take ownership of frontend organisation and implementation, focusing on maintainability, reuse, and teamwork.'), points: [t('Δομή έργου και επαναχρησιμοποιήσιμα components', 'Project structure and reusable components'), t('Καθοδήγηση εκπαιδευόμενων developers', 'Mentoring trainee developers'), t('Git, επίλυση προβλημάτων και συνεννόηση με backend ομάδες', 'Git, troubleshooting, and coordination with backend teams')] },
];
const technologies = [
  { name: 'Vue.js', kind: 'vue', color: '#42b883', detail: t('Διαδραστικές web εφαρμογές', 'Interactive web applications') },
  { name: 'React Native', kind: 'react', color: '#61dafb', detail: t('Εφαρμογές κινητού με React', 'Mobile apps built with React') },
  { name: 'Expo', kind: 'expo', color: '#dce9ff', detail: t('Εργαλεία για εφαρμογές κινητού', 'Tools for mobile app development') },
  { name: 'Astro', kind: 'astro', color: '#ff9b73', detail: t('Γρήγορες εταιρικές ιστοσελίδες', 'Fast business websites') },
  { name: 'JavaScript', kind: 'js', color: '#f7df1e', detail: t('Λογική εφαρμογών & αλληλεπίδραση', 'Application logic & interaction') },
  { name: 'HTML & CSS', kind: 'html', color: '#f99570', detail: t('Σημασιολογική δομή & responsive UI', 'Semantic structure & responsive UI') },
  { name: 'Flutter', kind: 'flutter', color: '#54c5f8', detail: t('Εφαρμογές & εκπαιδευτικό υλικό', 'Applications & learning material') },
  { name: 'Git', kind: 'git', color: '#f58470', detail: t('Εκδόσεις κώδικα & συνεργασία', 'Version control & collaboration') },
];
---
<div class="wrap skills-page">
  <section class="skills-intro"><p class="skills-label">{t('ΔΕΞΙΟΤΗΤΕΣ ΜΕ ΠΡΑΚΤΙΚΗ ΑΞΙΑ', 'SKILLS WITH PRACTICAL VALUE')}</p><h1>{t('Από την ιδέα σας', 'From your idea')}<br /><em>{t('σε μια εφαρμογή που σας εξυπηρετεί.', 'to an app that works for you.')}</em></h1><p>{t('Αναπτύσσω λογισμικό, σχεδιάζω ιστοσελίδες και βοηθώ επιχειρήσεις να βελτιώσουν την παρουσία τους στο διαδίκτυο. Στόχος μου είναι να προβάλλετε καθαρά τη δουλειά σας και να οργανώνετε πιο εύκολα τις καθημερινές σας εργασίες.', 'I develop software, design websites, and help businesses improve their online presence. My goal is to help you showcase your work clearly and manage daily tasks more easily.')}</p></section>
  <section aria-labelledby="capabilities-title"><h2 id="capabilities-title" class="skills-heading">{t('Τι μπορώ να προσφέρω στο έργο σας', 'What I can bring to your project')}</h2><div class="capability-grid">{services.map((service) => <article class="capability-card"><span class="capability-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={service.icon} /></svg></span><h3>{service.title}</h3><p>{service.text}</p><ul>{service.points.map(point => <li>{point}</li>)}</ul></article>)}</div></section>
  <section class="technology-section" aria-labelledby="technology-title"><p class="skills-label">{t('ΤΑ ΕΡΓΑΛΕΙΑ ΠΙΣΩ ΑΠΟ ΤΙΣ ΛΥΣΕΙΣ', 'THE TOOLS BEHIND THE SOLUTIONS')}</p><h2 id="technology-title" class="skills-heading">{t('Οι τεχνολογίες που χρησιμοποιώ.', 'The technologies I use.')}</h2><div class="technology-grid">{technologies.map(tech => <article class="technology-card"><span class="technology-icon" style={`--tech-color:${tech.color}`} aria-hidden="true"><svg viewBox="0 0 32 32" fill="currentColor">
    {tech.kind === 'vue' && <><path d="M1 4h6l9 16L25 4h6L16 30Z" /><path d="M7 4h6l3 6 3-6h6L16 20Z" fill="#7897a8" /></>}
    {tech.kind === 'react' && <g fill="none" stroke="currentColor" stroke-width="1.4"><ellipse cx="16" cy="16" rx="15" ry="6" /><ellipse cx="16" cy="16" rx="15" ry="6" transform="rotate(60 16 16)" /><ellipse cx="16" cy="16" rx="15" ry="6" transform="rotate(120 16 16)" /><circle cx="16" cy="16" r="2.5" fill="currentColor" stroke="none" /></g>}
    {tech.kind === 'expo' && <path d="M14 5c1-2 3-2 4 0l13 23h-7L16 14 8 28H1Z" />}
    {tech.kind === 'astro' && <><path d="m12 2-8 23 8-4 4-13 4 13 8 4-8-23Z" /><path d="M11 24c3 2 7 2 10 0-1 4-3 4-3 8-4-2-6-3-7-8" fill="#ff5d8f" /></>}
    {tech.kind === 'js' && <><rect x="2" y="2" width="28" height="28" rx="2" /><text x="7" y="25" fill="#0c192b" font-size="17" font-family="Arial, sans-serif" font-weight="bold">JS</text></>}
    {tech.kind === 'html' && <><path d="m3 2 2 25 11 3 11-3 2-25Z" /><path d="M9 8h14l-.5 4H13l.3 3h9l-1 8-5.3 1.5-5.3-1.5-.4-4h4l.2 1 1.5.5 1.6-.5.3-2H9.7Z" fill="#0c192b" /></>}
    {tech.kind === 'flutter' && <><path d="m18 2-16 16 5 5L28 2Zm0 14-9 9 5 5 14-14Z" /><path d="m14 20 10 10h-10l-5-5Z" fill="#2786c5" /></>}
    {tech.kind === 'git' && <><rect x="5" y="5" width="22" height="22" rx="2" transform="rotate(45 16 16)" /><path d="m10 5 12 12M15 10v15" fill="none" stroke="#0c192b" stroke-width="2" /><g fill="#0c192b"><circle cx="15" cy="10" r="2.5" /><circle cx="22" cy="17" r="2.5" /><circle cx="15" cy="25" r="2.5" /></g></>}
  </svg></span><div><h3>{tech.name}</h3><p>{tech.detail}</p></div></article>)}</div><p class="additional-tools">{t('Επιπλέον εμπειρία σε WordPress, Joomla, PHP / CodeIgniter, MySQL, Node.js, Electron και διαδραστικούς χάρτες με Leaflet / OpenLayers.', 'Additional experience with WordPress, Joomla, PHP / CodeIgniter, MySQL, Node.js, Electron, and interactive maps with Leaflet / OpenLayers.')}</p></section>
  <section class="skills-collaboration"><div><p class="skills-label">{t('ΤΕΧΝΟΛΟΓΙΑ & ΕΠΙΚΟΙΝΩΝΙΑ', 'TECHNOLOGY & COMMUNICATION')}</p><h2>{t('Ξεκάθαρη επικοινωνία σε κάθε βήμα.', 'Clear communication at every step.')}</h2><p>{t('Συζητάμε τι χρειάζεστε και αποφασίζουμε μαζί από πού θα ξεκινήσουμε. Συνεργάζομαι στα ελληνικά και στα αγγλικά, με πιστοποίηση ECPE και εμπειρία σε παρουσιάσεις προς Ευρωπαίους εταίρους.', 'We discuss what you need and decide together where to start. I collaborate in Greek and English, with ECPE certification and experience presenting to European project partners.')}</p></div><a class="button" href={href(lang, 'contact')}>{t('Ας σχεδιάσουμε το έργο σας', 'Let’s plan your project')}</a></section>
</div>
