---
import { Image } from 'astro:assets';
import cooling from '../assets/projects/coolingenergy-preview.jpg';
import adopto from '../assets/projects/adopto.jpg';
import foodeat from '../assets/projects/foodeat-logo.png';
import { href, type Lang } from '../data/i18n';
import '../styles/featured-projects.css';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (el: string, en: string) => lang === 'el' ? el : en;
const projectsUrl = href(lang, 'projects');
---
<section class="wrap featured-work" aria-labelledby="featured-title">
  <div class="featured-heading"><div><p class="featured-label">{t('ΕΠΙΛΕΓΜΕΝΑ ΕΡΓΑ', 'SELECTED WORK')}</p><h2 id="featured-title">{t('Η δουλειά μου, στην πράξη.', 'My work, in action.')}</h2></div><p>{t('Ιστοσελίδες και εφαρμογές για διαφορετικές ανάγκες, με συγκεκριμένα αποτελέσματα.', 'Websites and applications built for different needs, with tangible results.')}</p></div>
  <article class="home-foodflow">
    <div class="home-award"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10v7a5 5 0 0 1-10 0V3Zm0 2H3v3a4 4 0 0 0 4 4m10-7h4v3a4 4 0 0 1-4 4m-5 3v6m-5 0h10" /></svg><div><strong>{t('1η θέση στην κατηγορία Fintech', '1st place in the Fintech category')}</strong><span>Foodtech Hackathon · {t('Διάκριση της ομάδας AIPath', 'AIPath team achievement')}</span></div></div>
    <div class="home-foodflow-grid"><div class="featured-copy"><p class="featured-label">{t('AIPath · Χονδρική & διανομή', 'AIPath · Wholesale & distribution')}</p><h3>AIPath FoodFlow</h3><p>{t('Από τις παραγγελίες μέσω κειμένου, εικόνας και φωνής μέχρι την αποθήκη, τη διανομή και τον οικονομικό έλεγχο. Μια πλατφόρμα που αναπτύχθηκε μαζί με τους ανθρώπους της Foodeat, με βάση τις καθημερινές ανάγκες της επιχείρησης.', 'From orders arriving as text, images, and voice to warehouse operations, delivery, and financial oversight. A platform developed alongside the people at Foodeat, shaped by everyday business needs.')}</p><p class="featured-contribution">{t('Η συνεισφορά μου: αρχιτεκτονική και ανάπτυξη frontend στο οικοσύστημα web και mobile της Foodeat.', 'My contribution: frontend architecture and development across Foodeat’s web and mobile ecosystem.')}</p><a class="featured-link" href={`${projectsUrl}#foodflow`}>{t('Γνωρίστε τη FoodFlow', 'Explore FoodFlow')}</a></div>
      <div class="home-flow-visual" aria-label={t('Σχηματική παρουσίαση FoodFlow', 'Illustrated FoodFlow overview')}><div class="home-preview-bar"><span aria-hidden="true">● ● ●</span><span>FoodFlow / Foodeat</span></div><div class="home-flow-body"><Image src={foodeat} alt="Foodeat" width={190} format="webp" loading="lazy" /><div class="home-flow-inputs"><span>{t('Κείμενο', 'Text')}</span><span>{t('Εικόνα', 'Image')}</span><span>{t('Φωνή', 'Voice')}</span></div><div class="home-flow-review"><span aria-hidden="true">✦</span>{t('AI με ανθρώπινο έλεγχο', 'AI with human review')}</div><div class="home-flow-output"><span>{t('Παραγγελία', 'Order')}</span><span>{t('Οργάνωση', 'Operations')}</span><span>{t('Παράδοση', 'Delivery')}</span></div><p>{t('Από την παραγγελία στην παράδοση.', 'From order to delivery.')}</p></div></div>
    </div>
  </article>
  <div class="home-project-grid">
    <article class="home-project home-cooling"><a class="home-site-preview" href={`${projectsUrl}#coolingenergy`} aria-label={t('Δείτε το έργο CoolingEnergy', 'Explore the CoolingEnergy project')}><div class="home-preview-bar"><span aria-hidden="true">● ● ●</span><span>coolingenergy.gr</span></div><Image src={cooling} alt={t('Η αρχική σελίδα της CoolingEnergy', 'The CoolingEnergy homepage')} widths={[600, 1000]} sizes="(max-width: 760px) 90vw, 45vw" width={1000} format="webp" loading="lazy" /></a><div class="featured-copy"><p class="featured-label">{t('Ιστοσελίδα επιχείρησης · Local SEO', 'Business website · Local SEO')}</p><h3>CoolingEnergy</h3><p>{t('Μια σύγχρονη παρουσία για τεχνικές υπηρεσίες στον Βόλο και το Πήλιο. Σχεδιασμός, κατασκευή με Astro, σελίδες υπηρεσιών και τοπικό SEO, με εύκολη επικοινωνία από κάθε συσκευή.', 'A modern website for technical services in Volos and Pelion. Designed and built with Astro, with dedicated service pages, local SEO, and easy ways to get in touch from any device.')}</p><a class="featured-link" href={`${projectsUrl}#coolingenergy`}>{t('Δείτε το έργο', 'Explore the project')}</a></div></article>
    <article class="home-project home-adopto"><a class="home-adopto-preview" href={`${projectsUrl}#adopto`} aria-label={t('Δείτε το έργο Adopto', 'Explore the Adopto project')}><div class="adopto-preview-copy"><svg aria-hidden="true" viewBox="0 0 48 48" fill="currentColor"><ellipse cx="11" cy="14" rx="5" ry="7" transform="rotate(-25 11 14)" /><ellipse cx="22" cy="9" rx="5" ry="7" /><ellipse cx="33" cy="12" rx="5" ry="7" transform="rotate(20 33 12)" /><ellipse cx="41" cy="22" rx="4" ry="6" transform="rotate(30 41 22)" /><path d="M11 31c3-5 6-9 12-9s9 4 12 9c7 11-3 14-9 10-2-1-4-1-6 0-7 4-16 0-9-10Z" /></svg><strong>Adopto</strong><span>{t('Μια νέα αρχή.', 'A new beginning.')}<br />{t('Ένα νέο σπίτι.', 'A new home.')}</span><div>Web · Android · iOS</div></div><div class="home-adopto-phone"><Image src={adopto} alt={t('Προεπισκόπηση Adopto με ζώα προς υιοθεσία', 'Adopto preview showing animals for adoption')} widths={[360, 600]} sizes="200px" width={600} format="webp" loading="lazy" /></div></a><div class="featured-copy"><p class="featured-label">{t('Web & mobile · Φροντίδα αδέσποτων', 'Web & mobile · Stray animal welfare')}</p><h3>Adopto</h3><p>{t('Συμμετοχή σε ένα web και mobile έργο για Android και iOS που συνδέει αδέσποτα ζώα με ανθρώπους που θέλουν να τα υιοθετήσουν, με εύχρηστη αναζήτηση και παρουσίαση αγγελιών.', 'Contributed to Adopto’s website and Android and iOS apps, helping people find stray animals available for adoption through clear, easy-to-browse listings.')}</p><a class="featured-link" href={`${projectsUrl}#adopto`}>{t('Δείτε το έργο', 'Explore the project')}</a></div></article>
  </div>
  <div class="featured-all"><a class="button" href={projectsUrl}>{t('Δείτε όλα τα έργα', 'Explore all projects')}</a></div>
</section>
