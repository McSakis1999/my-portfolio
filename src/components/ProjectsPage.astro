---
import { Image } from 'astro:assets';
import coolingPreview from '../assets/projects/coolingenergy-preview.jpg';
import foodeatMobile from '../assets/projects/foodeat-mobile.jpg';
import adoptoPreview from '../assets/projects/adopto.jpg';
import workcardLogo from '../assets/projects/workcard-logo.png';
import foodeatLogo from '../assets/projects/foodeat-logo.png';
import { career, href, type Lang } from '../data/i18n';
import '../styles/projects.css';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (el: string, en: string) => lang === 'el' ? el : en;
const projects = [
  { id: 'workcard', name: 'Workcard / ORA', category: t('AIPath · Επιχειρησιακή εφαρμογή', 'AIPath · Business application'), icon: 'M4 5h16v16H4zM4 10h16M8 2v6m8-6v6M8 14h2m4 0h2m-8 4h2', text: t('Εφαρμογή διαχείρισης προγραμμάτων εργασίας και ψηφιακής κάρτας. Οργανώνει βάρδιες, άδειες και καταγραφές σε ένα περιβάλλον για την καθημερινή εργασία των διαχειριστών.', 'An application for managing work schedules and digital time cards. It brings shifts, leave, and attendance records together to simplify daily administration.'), role: t('Ανάπτυξη του frontend για ημερολόγια, επεξεργασία βαρδιών, φίλτρα, ενημέρωση για τον συγχρονισμό και διαχείριση διορθώσεων, σε συνεργασία με την ομάδα του backend.', 'Frontend development for calendars, shift editing, filters, sync status, and record corrections, working with the backend team.'), tags: ['Vue.js', 'PrimeVue', 'API integration'], labels: [t('Πρόγραμμα', 'Schedule'), t('Βάρδιες', 'Shifts'), t('Καταγραφές', 'Attendance')] },
  { id: 'mobile', name: 'Foodeat Mobile', category: t('AIPath · Εφαρμογές πελατών & οδηγών', 'AIPath · Customer & driver applications'), icon: 'M7 2h10v20H7zM11 5h2m-2 14h2', text: t('Εφαρμογές κινητού για τους πελάτες και τους οδηγούς της Foodeat: καταχώριση παραγγελιών και υποστήριξη των καθημερινών παραδόσεων.', 'Mobile apps for Foodeat’s customers and drivers, supporting order placement and daily deliveries.'), role: t('Ανάπτυξη της εφαρμογής πελατών με React Native και Expo, ροές σύνδεσης και παραγγελίας, διασύνδεση με backend και δοκιμές σε συσκευές. Αρχική οργάνωση και δημιουργία προτύπων για τη νέα εφαρμογή οδηγών.', 'Development of the customer app with React Native and Expo, sign-in and ordering flows, backend integration, and device testing. Initial setup and reusable templates for the new driver app.'), tags: ['React Native', 'Expo', 'Android'], labels: [t('Πελάτες', 'Customers'), t('Παραγγελίες', 'Orders'), t('Οδηγοί', 'Drivers')] },
  { id: 'adopto', name: 'Adopto', category: t('Web & mobile · Αδέσποτα ζώα', 'Web & mobile · Stray animals'), text: t('Μια πλατφόρμα που συνδέει αδέσποτα ζώα με ανθρώπους που θέλουν να τα υιοθετήσουν. Παρουσιάζει αγγελίες ζώων προς υιοθεσία και σχετικές πληροφορίες, μέσω ιστοσελίδας και εφαρμογών για Android και iOS.', 'A platform that helps stray animals find homes. Its website and Android and iOS apps let people browse adoption listings and learn about each animal.'), role: t('Συμμετοχή στην ανάπτυξη του web και mobile έργου Adopto, ώστε οι χρήστες να βρίσκουν εύκολα ζώα προς υιοθεσία και τις πληροφορίες που χρειάζονται.', 'Contributed to Adopto’s website and mobile apps, helping users find animals available for adoption and the information they need.'), tags: ['Web', 'Android', 'iOS'], labels: [] },
];
---
<div class="wrap projects-page">
  <section class="projects-intro"><p class="projects-label">{t('ΕΡΓΑ & ΣΥΝΕΙΣΦΟΡΕΣ', 'PROJECTS & CONTRIBUTIONS')}</p><h1>{t('Ιδέες που έγιναν', 'Ideas turned into')}<br /><em>{t('πραγματικές εφαρμογές.', 'real applications.')}</em></h1><p>{t('Από την ψηφιακή παρουσία μιας τοπικής επιχείρησης μέχρι συστήματα που στηρίζουν την καθημερινή λειτουργία μιας ομάδας. Επιλεγμένα έργα και η δική μου συνεισφορά σε καθένα.', 'From a local business’s online presence to systems that support a team’s daily operations. Selected projects and my contribution to each.')}</p><div class="project-index"><a href="#foodflow">AIPath FoodFlow</a><a href="#coolingenergy">CoolingEnergy</a><a href="#more-projects">{t('Web & mobile έργα', 'Web & mobile work')}</a></div></section>
  <article class="foodflow-feature" id="foodflow">
    <div class="award-banner"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M7 3h10v7a5 5 0 0 1-10 0V3Zm0 2H3v3a4 4 0 0 0 4 4m10-7h4v3a4 4 0 0 1-4 4m-5 3v6m-5 0h10" /></svg><div><strong>{t('1η θέση · Fintech · Foodtech Hackathon', '1st place · Fintech · Foodtech Hackathon')}</strong><span>{t('Διάκριση της ομάδας AIPath για την πλατφόρμα FoodFlow', 'An AIPath team award for the FoodFlow platform')}</span></div></div>
    <div class="foodflow-layout"><div><p class="projects-label">{t('AIPath · Πλατφόρμα χονδρικής & διανομής', 'AIPath · Wholesale & distribution platform')}</p><h2>AIPath FoodFlow</h2><p class="project-subtitle">{t('Από την παραγγελία στην παράδοση. Σε ένα σύστημα.', 'From order to delivery. In one system.')}</p><p>{t('Οι παραγγελίες μιας επιχείρησης χονδρικής φτάνουν από τηλέφωνο, Viber, email και χειρόγραφες σημειώσεις. Η FoodFlow συνδέει την καταχώριση, την αποθήκη, τις προμήθειες, τη διανομή και τον οικονομικό έλεγχο, διατηρώντας διαθέσιμη τη γνώση της καθημερινής λειτουργίας σε όλη την ομάδα.', 'Wholesale orders arrive by phone, Viber, email, and handwritten notes. FoodFlow connects order entry, warehouse operations, procurement, delivery, and financial oversight, keeping day-to-day operational knowledge available to the whole team.')}</p><p>{t('Η ομάδα της AIPath ανέπτυξε την πλατφόρμα μαζί με τους ανθρώπους της Foodeat, μέσα από 2,5 χρόνια ανάπτυξης και καθημερινής εφαρμογής. Η τεχνητή νοημοσύνη υποστηρίζει παραγγελίες από κείμενο, εικόνα και φωνή, με ανθρώπινο έλεγχο πριν από την ολοκλήρωση.', 'The AIPath team developed the platform alongside the people at Foodeat through 2.5 years of development and daily use. AI supports orders from text, images, and voice, with human review before completion.')}</p><div class="project-role"><h3>{t('Η δική μου συνεισφορά', 'My contribution')}</h3><p>{t('Ως Lead Frontend Developer στην AIPath, εργάζομαι στην αρχιτεκτονική και υλοποίηση των web διεπαφών του οικοσυστήματος Foodeat: διαχείριση παραγγελιών, έλεγχος AI καταχωρίσεων, εργαλεία προμηθειών και διανομής, καθώς και εφαρμογές για τους πελάτες, στο διαδίκτυο και στο κινητό.', 'As Lead Frontend Developer at AIPath, I work on the architecture and implementation of the Foodeat ecosystem’s web interfaces: order management, review of AI-generated entries, procurement and delivery tools, customer-facing web and mobile applications.')}</p></div><div class="project-tags"><span>Vue.js</span><span>PrimeVue</span><span>React Native</span><span>API integration</span></div></div>
      <div class="flow-preview"><div class="preview-top"><span class="preview-dots" aria-hidden="true">● ● ●</span><span>FoodFlow</span></div><div class="flow-content"><div class="foodflow-brand"><Image src={foodeatLogo} alt="Foodeat" width={190} format="webp" loading="lazy" /><span>{t('Το οικοσύστημα πίσω από τη FoodFlow', 'The ecosystem behind FoodFlow')}</span></div><p class="flow-title">{t('Όλη η διαδικασία σε ένα σύστημα.', 'The whole process in one system.')}</p><div class="input-types"><span>{t('Κείμενο', 'Text')}</span><span>{t('Εικόνα', 'Image')}</span><span>{t('Φωνή', 'Voice')}</span></div><div class="flow-core"><span aria-hidden="true">✦</span><strong>{t('AI & ανθρώπινος έλεγχος', 'AI & human review')}</strong></div><div class="flow-steps">{[t('Παραγγελία', 'Order'), t('Αποθήκη & προμήθειες', 'Warehouse & procurement'), t('Διανομή', 'Delivery'), t('Οικονομικός έλεγχος', 'Financial oversight')].map(label => <div><span aria-hidden="true">✓</span>{label}</div>)}</div></div><p class="preview-caption">{t('Σχηματική παρουσίαση της ροής της πλατφόρμας', 'Illustrated overview of the platform workflow')}</p></div>
    </div><p class="award-note">{t('Η FoodFlow προκρίθηκε επίσης στη Β΄ φάση του 17ου Διαγωνισμού Καινοτομίας & Τεχνολογίας της Εθνικής Τράπεζας.', 'FoodFlow also advanced to Phase B of the National Bank of Greece’s 17th Innovation & Technology Competition.')}</p>
  </article>
  <article class="cooling-feature" id="coolingenergy"><a class="website-preview" href="https://coolingenergy.gr/" target="_blank" rel="noopener noreferrer" aria-label={t('Επισκεφθείτε την CoolingEnergy — νέα καρτέλα', 'Visit CoolingEnergy — new tab')}><div class="preview-top"><span class="preview-dots" aria-hidden="true">● ● ●</span><span>coolingenergy.gr</span></div><Image src={coolingPreview} alt={t('Προεπισκόπηση της αρχικής σελίδας CoolingEnergy', 'Preview of the CoolingEnergy homepage')} widths={[600, 1000, 1600]} sizes="(max-width: 760px) 90vw, 50vw" width={1000} format="webp" loading="lazy" /><span class="preview-caption">{t('Προεπισκόπηση της δημοσιευμένης ιστοσελίδας', 'Preview of the published website')}</span></a><div class="cooling-copy"><p class="projects-label">{t('ΙΣΤΟΣΕΛΙΔΑ ΤΟΠΙΚΗΣ ΕΠΙΧΕΙΡΗΣΗΣ', 'LOCAL BUSINESS WEBSITE')}</p><h2>CoolingEnergy</h2><p class="project-subtitle">{t('Τεχνικές υπηρεσίες στον Βόλο & το Πήλιο.', 'Technical services in Volos & Pelion.')}</p><p>{t('Ιστοσελίδα για υπηρεσίες κλιματισμού και επισκευής οικιακών συσκευών. Ο επισκέπτης βρίσκει την υπηρεσία που χρειάζεται, ενημερώνεται για τις περιοχές κάλυψης και επικοινωνεί εύκολα με τον τεχνικό.', 'A website for air-conditioning and appliance repair services. Visitors can find the service they need, check coverage areas, and easily contact the technician.')}</p><div class="project-role"><h3>{t('Σχεδιασμός & υλοποίηση', 'Design & implementation')}</h3><p>{t('Κατασκευή με Astro και σχεδιασμός για κινητά και υπολογιστές. Αναλυτικές σελίδες υπηρεσιών και περιοχών εξυπηρέτησης, τοπικό SEO, συχνές ερωτήσεις, προεπισκοπήσεις για κοινοποιήσεις στα κοινωνικά δίκτυα και εύκολη τηλεφωνική επικοινωνία.', 'Built with Astro for phones and computers, with detailed service and coverage pages, local SEO, FAQs, social-sharing previews, and easy ways to call or enquire.')}</p></div><div class="project-tags"><span>Astro</span><span>Tailwind CSS</span><span>Local SEO</span></div><a class="button" href="https://coolingenergy.gr/" target="_blank" rel="noopener noreferrer">{t('Δείτε την ιστοσελίδα', 'Visit the website')}</a></div></article>
  <section class="more-projects" id="more-projects" aria-labelledby="more-projects-title"><h2 id="more-projects-title">{t('Web, mobile και επιχειρησιακές εφαρμογές', 'Web, mobile, and business applications')}</h2><div class="project-grid">{projects.map(project => <article id={project.id} class={`portfolio-project project-${project.id}`}><div class="app-preview branded-preview">
<div class="preview-top"><span class="preview-dots" aria-hidden="true">● ● ●</span><span>{project.name}</span></div>
{project.id === 'workcard' ? <div class="workcard-brand"><Image src={workcardLogo} alt="Workcard / ORA" width={180} format="webp" loading="lazy" /><div class="preview-modules">{project.labels.map(label => <span>{label}</span>)}</div></div> : <div class="phone-stage"><div class="project-phone"><Image src={project.id === 'mobile' ? foodeatMobile : adoptoPreview} alt={project.id === 'mobile' ? t('Οθόνη καλωσορίσματος Foodeat Delivery', 'Foodeat Delivery welcome screen') : t('Adopto: ζώα διαθέσιμα για υιοθεσία', 'Adopto: animals available for adoption')} widths={[360, 600]} sizes="240px" width={600} format="webp" loading="lazy" /></div></div>}
</div><p class="preview-caption">{project.id === 'workcard' ? t('Λογότυπο Workcard / ORA', 'Workcard / ORA logo') : t('Πραγματικό στιγμιότυπο της εφαρμογής', 'Actual application screenshot')}</p><div class="project-body"><p class="projects-label">{project.category}</p><h3>{project.name}</h3><p>{project.text}</p><div class="project-role"><h4>{t('Η δική μου συνεισφορά', 'My contribution')}</h4><p>{project.role}</p></div><div class="project-tags">{project.tags.map(tag => <span>{tag}</span>)}</div></div></article>)}</div></section>
  <section class="earlier-work" aria-labelledby="earlier-title"><p class="projects-label">{t('ΕΚΠΑΙΔΕΥΣΗ & ΠΡΟΗΓΟΥΜΕΝΑ ΕΡΓΑ', 'EDUCATION & EARLIER WORK')}</p><h2 id="earlier-title">{t('Περισσότερα από την πορεία μου', 'More of my work')}</h2><div>{career(lang).projects.map(project => <article><p class="earlier-period">{project.period}</p><h3>{project.title}</h3><p>{project.text}</p></article>)}</div></section>
  <section class="projects-next"><div><h2>{t('Το επόμενο έργο μπορεί να είναι το δικό σας.', 'Your project could be next.')}</h2><p>{t('Πείτε μου τι θέλετε να δημιουργήσετε, για να δούμε μαζί πώς μπορούμε να ξεκινήσουμε.', 'Tell me what you’d like to create, and we’ll work out how to get started.')}</p></div><a class="button" href={href(lang, 'contact')}>{t('Ας μιλήσουμε', 'Let’s talk')}</a></section>
</div>
<script>
  const page = document.querySelector('.projects-page');
  if (page && 'IntersectionObserver' in window) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sections = page.querySelectorAll('.foodflow-feature, .cooling-feature, .portfolio-project, .earlier-work article, .projects-next');
    const entrance = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        if (!motion.matches) entry.target.classList.add('project-enter');
        entrance.unobserve(entry.target);
      }
    }, { threshold: 0.08 });
    sections.forEach(section => entrance.observe(section));
    const flow = page.querySelector('.flow-preview');
    if (flow) {
      const visibility = new IntersectionObserver(entries => {
        for (const entry of entries) entry.target.classList.toggle('flow-active', entry.isIntersecting);
      }, { threshold: 0.15 });
      visibility.observe(flow);
    }
  }
</script>




