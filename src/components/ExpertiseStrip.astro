---
import type { Lang } from '../data/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (el: string, en: string) => lang === 'el' ? el : en;
const items = [
  { title: t('Ανάπτυξη λογισμικού', 'Software engineering'), description: t('Από την αρχιτεκτονική στην υλοποίηση.', 'From architecture to implementation.'), icon: 'M8 7 3 12l5 5m8-10 5 5-5 5M14 4l-4 16' },
  { title: t('Web εφαρμογές', 'Web development'), description: t('Εύκολη χρήση από κάθε συσκευή.', 'Easy to use on any device.'), icon: 'M3 8h18M6 5h.01M9 5h.01M8 13l-2 2 2 2m8-4 2 2-2 2' },
  { title: t('Λύσεις για επιχειρήσεις', 'Solutions for businesses'), description: t('Πραγματικές ανάγκες. Πρακτικές λύσεις.', 'Real needs. Practical solutions.'), icon: 'M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12a20 20 0 0 0 18 0M12 11v4' },
];
---
<section class="expertise-strip" aria-label={t('Τομείς δραστηριότητας', 'Areas of expertise')}>
  <ul class="wrap expertise-list">
    {items.map((item, index) => <li class="expertise-item">
      <span class="expertise-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          {index === 1 && <rect x="2" y="2" width="20" height="20" rx="3" />}
          {index === 2 && <rect x="3" y="7" width="18" height="14" rx="3" />}
          <path d={item.icon} />
        </svg>
      </span>
      <div><h2>{item.title}</h2><p>{item.description}</p></div>
    </li>)}
  </ul>
</section>
<style>
  .expertise-strip {
    position: relative;
    border-block: 1px solid var(--tone-29425f, #29425f);
    background: radial-gradient(ellipse at 50% 0, var(--tone-16477645, #16477645), transparent 75%), var(--tone-0a1424, #0a1424);
  }
  .expertise-strip::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 15%;
    width: 70%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
  }
  .expertise-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0; margin-block: 0; list-style: none; }
  .expertise-item { display: flex; align-items: center; gap: 18px; position: relative; padding: 32px 24px; }
  .expertise-item:first-child { padding-left: 0; }
  .expertise-item:last-child { padding-right: 0; }
  .expertise-item + .expertise-item::before { content: ''; position: absolute; left: 0; top: 25%; height: 50%; width: 1px; background: linear-gradient(transparent, var(--tone-345271, #345271), transparent); }
  .expertise-icon { display: grid; place-items: center; width: 48px; height: 48px; flex-shrink: 0; color: var(--accent); border: 1px solid var(--tone-35597d, #35597d); border-radius: 14px; background: linear-gradient(135deg, var(--tone-183450, #183450), var(--tone-0b1a2d, #0b1a2d)); box-shadow: inset 0 1px var(--tone-ffffff0d, #ffffff0d), 0 6px 20px var(--tone-00000020, #00000020); transition: border-color 250ms, box-shadow 250ms, transform 250ms; }
  .expertise-item:nth-child(2) .expertise-icon { color: var(--cyan); }
  .expertise-item:nth-child(3) .expertise-icon { color: var(--tone-a3baff, #a3baff); }
  .expertise-icon svg { width: 24px; height: 24px; }
  .expertise-item h2 { margin: 0 0 7px; font-size: 1rem; font-weight: 600; line-height: 1.45; letter-spacing: 0; }
  .expertise-item p { margin: 0; font-size: .875rem; line-height: 1.6; color: var(--muted); }
  @media (hover: hover) {
    .expertise-item:hover .expertise-icon { border-color: var(--accent); box-shadow: 0 0 24px var(--tone-66b6ff20, #66b6ff20); transform: translateY(-3px); }
  }
  @media (max-width: 1050px) {
    .expertise-item { flex-direction: column; align-items: flex-start; padding: 28px 20px; }
  }
  @media (max-width: 760px) {
    .expertise-list { grid-template-columns: 1fr; }
    .expertise-item, .expertise-item:first-child, .expertise-item:last-child { flex-direction: row; align-items: center; padding: 22px 0; }
    .expertise-item + .expertise-item::before { top: 0; left: 0; width: 100%; height: 1px; background: linear-gradient(90deg, var(--tone-345271, #345271), transparent); }
  }
  @media (prefers-reduced-motion: reduce) { .expertise-icon { transition: none; } .expertise-item:hover .expertise-icon { transform: none; } }
</style>
