---
import { href, type Lang } from '../data/i18n';
import { profile } from '../data/portfolio';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (el: string, en: string) => lang === 'el' ? el : en;
---
<section class="wrap contact-banner" aria-labelledby="collaboration-title" data-reveal>
  <div class="banner-copy">
    <p class="banner-label">{t('ΑΣ ΣΥΝΕΡΓΑΣΤΟΥΜΕ', 'LET’S WORK TOGETHER')}</p>
    <h2 id="collaboration-title">{t('Έχετε μια ιδέα;', 'Have an idea?')}<br /><em>{t('Ας την κάνουμε πράξη.', 'Let’s make it happen.')}</em></h2>
    <p class="banner-description">{t('Χρειάζεστε μια ιστοσελίδα για την επιχείρησή σας, μια εφαρμογή ή βελτιώσεις σε ένα υπάρχον προϊόν; Ας συζητήσουμε τι θέλετε να πετύχετε και πώς μπορώ να βοηθήσω.', 'Need a website for your business, an application, or improvements to an existing product? Let’s discuss what you want to achieve and how I can help.')}</p>
    <ul class="banner-services" aria-label={t('Πώς μπορώ να βοηθήσω', 'How I can help')}>
      <li>{t('Ιστοσελίδες επιχειρήσεων', 'Business websites')}</li>
      <li>{t('Web & mobile εφαρμογές', 'Web & mobile apps')}</li>
      <li>{t('Βελτίωση προϊόντων', 'Product improvements')}</li>
    </ul>
    <p class="banner-career">{t('Αναζητάτε μηχανικό λογισμικού για την ομάδα σας; Θα χαρώ να συζητήσουμε και μια επαγγελματική ευκαιρία.', 'Looking for a software engineer for your team? I’d be happy to discuss a career opportunity, too.')}</p>
  </div>
  <div class="banner-contact">
    <div class="conversation-art" aria-hidden="true">
      <svg viewBox="0 0 220 150" fill="none">
        <circle cx="110" cy="75" r="63" stroke="currentColor" stroke-opacity=".2" stroke-dasharray="3 7" />
        <path d="M36 34a12 12 0 0 1 12-12h98a12 12 0 0 1 12 12v53a12 12 0 0 1-12 12H79l-25 19V99h-6a12 12 0 0 1-12-12Z" fill="#112942" stroke="#66b6ff" stroke-width="1.5" />
        <path d="m71 48-13 12 13 12m49-24 13 12-13 12m-19-28-10 32" stroke="#8ac8ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M137 78h44a11 11 0 0 1 11 11v26a11 11 0 0 1-11 11h-5v13l-17-13h-22a11 11 0 0 1-11-11V89a11 11 0 0 1 11-11Z" fill="#0c343f" stroke="#31d2e5" stroke-width="1.5" />
        <path d="M141 96h35m-35 12h23" stroke="#82e8ef" stroke-width="2" stroke-linecap="round" />
      </svg>
    </div>
    <p class="contact-prompt">{t('Όλα ξεκινούν με μια συζήτηση.', 'It starts with a conversation.')}</p>
    <a class="button banner-button" href={href(lang, 'contact')}>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
      {t('Ας μιλήσουμε', 'Let’s talk')}
    </a>
    <a class="banner-email" href={`mailto:${profile.email}`}>{profile.email}</a>
  </div>
</section>
<style>
  .contact-banner { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: 48px; padding: 48px; margin-bottom: 64px; border: 1px solid var(--tone-304d6b, #304d6b); border-radius: 24px; background: radial-gradient(ellipse at 100% 0, var(--tone-15536a55, #15536a55), transparent 65%), linear-gradient(130deg, var(--tone-11243c, #11243c), var(--tone-0b1729, #0b1729) 65%); box-shadow: 0 24px 60px var(--tone-00000025, #00000025); }
  .contact-banner::before { content: ''; position: absolute; top: -1px; left: 8%; width: 84%; height: 1px; background: linear-gradient(90deg, transparent, var(--accent), var(--cyan), transparent); }
  .banner-label { color: var(--cyan); font-family: Consolas, monospace; font-size: .875rem; letter-spacing: .12em; margin-bottom: 20px; }
  .banner-copy h2 { font-size: clamp(1.9rem, 3.3vw, 2.75rem); line-height: 1.2; letter-spacing: -.04em; font-weight: 600; margin-bottom: 24px; }
  .banner-description { max-width: 620px; font-size: 1rem; color: var(--tone-bdcde1, #bdcde1); line-height: 1.85; margin-bottom: 24px; }
  .banner-services { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0 0 24px; }
  .banner-services li { padding: 8px 12px; border: 1px solid var(--tone-345271, #345271); border-radius: 8px; background: var(--tone-132c4355, #132c4355); color: var(--tone-d3e6fa, #d3e6fa); font-size: .875rem; line-height: 1.5; }
  .banner-career { margin: 0; font-size: .875rem; line-height: 1.8; color: var(--muted); max-width: 560px; }
  .banner-contact { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; border-left: 1px solid var(--tone-34527180, #34527180); padding-left: 40px; min-width: 0; }
  .conversation-art { width: min(220px, 100%); color: var(--cyan); }
  .conversation-art svg { display: block; width: 100%; height: auto; filter: drop-shadow(0 10px 20px var(--tone-00000030, #00000030)); transition: transform 300ms; }
  .contact-prompt { margin: 16px 0 22px; font-size: 1rem; line-height: 1.6; color: var(--tone-d3e6fa, #d3e6fa); }
  .banner-button { width: 100%; max-width: 280px; gap: 12px; font-size: 1rem; padding: 17px 20px; }
  .banner-button svg { width: 21px; height: 21px; flex-shrink: 0; }
  .banner-email { display: inline-block; margin-top: 18px; font-size: .875rem; line-height: 1.6; overflow-wrap: anywhere; color: var(--muted); text-underline-offset: 4px; }
  .banner-email:hover { color: var(--cyan); text-decoration: underline; }
  @media (hover: hover) { .banner-contact:hover .conversation-art svg { transform: translateY(-4px); } }
  @media (max-width: 1050px) { .contact-banner { padding: 32px; gap: 28px; } .banner-contact { padding-left: 28px; } }
  @media (max-width: 760px) { .contact-banner { grid-template-columns: 1fr; padding: 28px 22px; margin-bottom: 40px; border-radius: 18px; } .banner-contact { border-left: 0; border-top: 1px solid var(--tone-34527180, #34527180); padding: 24px 0 0; } .conversation-art { width: 170px; } }
  @media (prefers-reduced-motion: reduce) { .conversation-art svg { transition: none; } .banner-contact:hover .conversation-art svg { transform: none; } }
</style>
